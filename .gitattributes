# Normalise text files to LF in the repository; check out with the platform's line endings.
* text=auto

# Windows batch files and the NSIS installer script need CRLF line endings to run reliably.
*.bat text eol=crlf
*.nsh text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.docx binary
