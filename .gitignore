# Model benchmark output (npm run bench)
bench-results/
*.log
npm-debug.log*
.vite/
*.tsbuildinfo
coverage/

# ---- Personal documents -------------------------------------------------------
# Assist Writer documents and recovery copies never belong in the repository.
*.awd
recovery/

# ---- Secrets and local settings -----------------------------------------------
.env
.env.*
.claude/settings.local.json

# ---- Editors and operating systems --------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
