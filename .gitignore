# ---- Dependencies -------------------------------------------------------------
node_modules/

# ---- Build output (all made from the sources) ---------------------------------
# Editor UI built by Vite (npm run build:ui)
out/
# Installer, portable app and web package (Build Dist.bat / npm run dist).
# Upload these to a GitHub Release instead of committing them.
dist/
# Rust build output
target/
# Generated by Tauri at build time
src-tauri/gen/

